rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function userData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isTrainerOf(uid) { return signedIn() && userData(uid).get('trainerId', null) == request.auth.uid; }
    // A gym's id is its owner's user id, so "owns gym X" is simply X == request.auth.uid
    // A text field that is absent, empty (null) or a string of at most n characters
    function textUpTo(d, f, n) { return d.get(f, null) == null || (d[f] is string && d[f].size() <= n); }
    function ownsGymOfTrainer(tid) { return signedIn() && tid != null && userData(tid).get('gymId', null) == request.auth.uid; }
    // Pause dates (a short list) and a membership end date ("YYYY-MM-DD" or empty)
    function pausesOK(d) { return !('pauses' in d) || d.pauses == null || (d.pauses is list && d.pauses.size() <= 20); }
    function memberEndOK(d) { return textUpTo(d, 'memberEnd', 10); }

    // A person's profile, settings and program
    match /users/{uid} {
      allow read: if isMe(uid)
        || (signedIn() && resource.data.get('trainerId', null) == request.auth.uid)
        || (signedIn() && resource.data.get('gymId', null) == request.auth.uid);   // gym owner reads their trainers
      allow create: if isMe(uid)
        && request.resource.data.role in ['client', 'trainer', 'owner']
        && request.resource.data.get('trainerId', null) == null
        && request.resource.data.get('gymId', null) == null;
      // The person themselves: can't change role; trainer and gym links only through a valid code
      allow update: if isMe(uid)
        && request.resource.data.role == resource.data.role
        && (request.resource.data.get('trainerId', null) == resource.data.get('trainerId', null)
            || request.resource.data.get('trainerId', null) == null
            || get(/databases/$(database)/documents/codes/$(request.resource.data.trainerCode)).data.trainerId == request.resource.data.trainerId)
        && (request.resource.data.get('gymId', null) == resource.data.get('gymId', null)
            || request.resource.data.get('gymId', null) == null
            || (resource.data.role == 'owner' && request.resource.data.gymId == uid)
            || (resource.data.role == 'trainer'
                && get(/databases/$(database)/documents/gymcodes/$(request.resource.data.gymCode)).data.gymId == request.resource.data.gymId));
      // Their trainer: may only change the program, pauses (holiday / illness) and the membership end date
      allow update: if signedIn() && resource.data.get('trainerId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['program', 'programUpdatedAt', 'pauses', 'memberEnd'])
        && pausesOK(request.resource.data) && memberEndOK(request.resource.data);
      // Deleting your own account
      allow delete: if isMe(uid);

      // Workouts, cardio, check-ins, DEXA scans and health reports
      match /{col}/{doc} {
        allow read: if isMe(uid)
          || (isTrainerOf(uid) && (col != 'reports' || resource.data.get('shared', false) == true));
        // The person themselves. Only their trainer can approve a workout (approval counts as attendance),
        // so a client can't add, change or remove the approval on their own workouts.
        allow create: if isMe(uid) && col in ['sessions', 'cardio', 'body', 'dexa', 'reports']
          && (col != 'sessions' || request.resource.data.get('approved', null) == null);
        allow update: if isMe(uid) && col in ['sessions', 'cardio', 'body', 'dexa', 'reports']
          && (col != 'sessions' || request.resource.data.get('approved', null) == resource.data.get('approved', null));
        allow delete: if isMe(uid) && col in ['sessions', 'cardio', 'body', 'dexa', 'reports'];
        // Trainer logging a client's workout on the gym screen
        allow create: if col == 'sessions' && isTrainerOf(uid);
        // Trainer approving a workout: the approval is the only thing they may change in what a client logged
        allow update: if col == 'sessions' && isTrainerOf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      }
    }

    // Trainer invite codes
    match /codes/{code} {
      allow get: if signedIn();   // look up one code; listing all codes is not allowed
      allow create: if signedIn() && request.resource.data.trainerId == request.auth.uid
        && userData(request.auth.uid).role == 'trainer';
      allow update, delete: if signedIn() && resource.data.trainerId == request.auth.uid;
    }

    // Gyms (id = owner's user id) and gym codes
    match /gyms/{gid} {
      allow read: if isMe(gid) || (signedIn() && userData(request.auth.uid).get('gymId', null) == gid);
      allow create: if isMe(gid) && request.resource.data.ownerId == gid && userData(gid).role == 'owner';
      allow update, delete: if isMe(gid);
    }
    match /gymcodes/{code} {
      allow get: if signedIn();   // look up one code; listing all codes is not allowed
      // Only a gym owner creates a code, for their own gym; only that owner can change or delete it later
      allow create: if signedIn() && request.resource.data.gymId == request.auth.uid
        && userData(request.auth.uid).role == 'owner';
      allow update: if signedIn() && resource.data.gymId == request.auth.uid
        && request.resource.data.gymId == request.auth.uid;
      allow delete: if signedIn() && resource.data.gymId == request.auth.uid;
    }

    // Public summary for leaderboards, buddies and gym owners: name, streak, rank, points, workout counts,
    // last workout, recent PBs, program summary. Never body weight, measurements, pain, notes, scans or reports.
    match /public/{uid} {
      allow read: if signedIn() && (isMe(uid)
        || resource.data.get('trainerId', null) == request.auth.uid
        || request.auth.uid in resource.data.get('buddies', [])
        || (resource.data.get('showOnBoard', false) == true
            && resource.data.get('trainerId', null) != null
            && resource.data.get('trainerId', null) == userData(request.auth.uid).get('trainerId', null))
        || ownsGymOfTrainer(resource.data.get('trainerId', null)));
      allow create: if isMe(uid) && request.resource.data.buddies.size() == 0
        && request.resource.data.get('trainerId', null) == userData(uid).get('trainerId', null);
      allow update: if isMe(uid) && request.resource.data.buddies.size() <= 20
        && request.resource.data.get('trainerId', null) == userData(uid).get('trainerId', null);
      allow delete: if isMe(uid);
      // Their trainer: may only set pause dates and the membership end date
      allow update: if signedIn() && !isMe(uid) && resource.data.get('trainerId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pauses', 'memberEnd'])
        && pausesOK(request.resource.data) && memberEndOK(request.resource.data);
      // Someone else: may only add themselves (with this person's buddy code) or remove themselves
      allow update: if signedIn() && !isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buddies', 'joinCode'])
        && request.resource.data.buddies.size() <= 20
        && ((request.resource.data.buddies.removeAll(resource.data.buddies).hasOnly([request.auth.uid])
             && request.resource.data.buddies.size() == resource.data.buddies.size() + 1
             && get(/databases/$(database)/documents/buddycodes/$(request.resource.data.joinCode)).data.uid == uid)
          || (resource.data.buddies.removeAll(request.resource.data.buddies).hasOnly([request.auth.uid])
             && request.resource.data.buddies.size() == resource.data.buddies.size() - 1));
    }

    // High-fives from buddies
    match /public/{uid}/fives/{fid} {
      allow read, delete: if isMe(uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/public/$(uid)).data.get('buddies', []);
    }

    // Buddy codes
    match /buddycodes/{code} {
      allow get: if signedIn();   // look up one code; listing all codes is not allowed
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Coach challenges and their leaderboards
    match /challenges/{cid} {
      allow read: if signedIn() && (resource.data.trainerId == request.auth.uid
        || resource.data.trainerId == userData(request.auth.uid).get('trainerId', null)
        || ownsGymOfTrainer(resource.data.trainerId));
      allow create: if signedIn() && request.resource.data.trainerId == request.auth.uid
        && userData(request.auth.uid).role == 'trainer';
      allow update, delete: if signedIn() && resource.data.trainerId == request.auth.uid;

      match /entries/{eid} {
        function chal() { return get(/databases/$(database)/documents/challenges/$(cid)).data; }
        allow read: if signedIn() && (chal().trainerId == request.auth.uid
          || chal().trainerId == userData(request.auth.uid).get('trainerId', null)
          || ownsGymOfTrainer(chal().trainerId));
        allow create, update: if isMe(eid) && chal().trainerId == userData(eid).get('trainerId', null)
          && (chal().get('members', null) == null || eid in chal().members);
        allow delete: if isMe(eid) || (signedIn() && chal().trainerId == request.auth.uid);
      }
    }

    // Recurring classes a trainer runs (e.g. Mon/Wed/Fri 7 am) for all their clients or selected troops
    match /classes/{cid} {
      allow read: if signedIn() && (resource.data.trainerId == request.auth.uid
        || resource.data.trainerId == userData(request.auth.uid).get('trainerId', null)
        || ownsGymOfTrainer(resource.data.trainerId));
      allow create: if signedIn() && request.resource.data.trainerId == request.auth.uid
        && userData(request.auth.uid).role == 'trainer';
      allow update: if signedIn() && resource.data.trainerId == request.auth.uid
        && request.resource.data.trainerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.trainerId == request.auth.uid;
    }

    // Attendance a trainer records (approved workouts and class roll calls); their gym owner reads it for billing
    match /trainers/{tid}/attendance/{aid} {
      allow read: if isMe(tid) || ownsGymOfTrainer(tid);
      allow create, update: if isMe(tid) && isTrainerOf(request.resource.data.clientId);
      allow delete: if isMe(tid);
    }

    // Follow-ups a trainer records from their weekly call list (Called / Back training / Lost); their gym owner sees the outcomes
    match /trainers/{tid}/calls/{cid} {
      allow read: if isMe(tid) || ownsGymOfTrainer(tid);
      allow create, update: if isMe(tid) && isTrainerOf(request.resource.data.clientId)
        && request.resource.data.keys().hasOnly(['clientId', 'clientName', 'week', 'date', 'outcome', 'why', 'ts'])
        && request.resource.data.outcome in ['called', 'back', 'lost']
        && textUpTo(request.resource.data, 'clientName', 120) && textUpTo(request.resource.data, 'why', 200)
        && textUpTo(request.resource.data, 'week', 10) && textUpTo(request.resource.data, 'date', 10);
      allow delete: if isMe(tid);
    }

    // A trainer's squads (client groups)
    match /trainers/{tid}/squads/{sid} {
      allow read, write: if isMe(tid);
    }

    // A trainer's private notes on their clients
    match /trainers/{tid}/notes/{nid} {
      allow read, delete: if isMe(tid);
      allow create, update: if isMe(tid) && isTrainerOf(request.resource.data.clientId);
    }

    // Workout-completed alerts for a trainer
    match /trainers/{tid}/alerts/{aid} {
      allow read, update, delete: if isMe(tid);
      // A client can see and remove the alerts about their own workouts (used when deleting their account)
      allow read, delete: if signedIn() && resource.data.clientId == request.auth.uid;
      // Only the fields a real alert has (workout finished, profile changed, account deleted), with length limits
      allow create: if signedIn() && request.resource.data.clientId == request.auth.uid
        && userData(request.auth.uid).get('trainerId', null) == tid
        && request.resource.data.keys().hasOnly(['clientId', 'clientName', 'kind', 'sessionId', 'title', 'text', 'day', 'date',
             'week', 'sets', 'durationMin', 'backPain', 'result', 'weight', 'notes', 'read', 'ts'])
        && request.resource.data.get('kind', 'workout') in ['workout', 'profile', 'deleted']
        && request.resource.data.get('read', false) == false
        && textUpTo(request.resource.data, 'clientName', 120) && textUpTo(request.resource.data, 'title', 200)
        && textUpTo(request.resource.data, 'text', 500) && textUpTo(request.resource.data, 'result', 300)
        && textUpTo(request.resource.data, 'notes', 2000) && textUpTo(request.resource.data, 'day', 20)
        && textUpTo(request.resource.data, 'sessionId', 80) && textUpTo(request.resource.data, 'date', 10);
    }
  }
}
